{% extends 'base.html.twig' %}

{% block title %}Log in!
{% endblock %}

{% block body %}
	<section class="flex flex-col items-center justify-center min-h-screen w-full gap-10 ">
		{% for flash_error in app.flashes('verify_email_error') %}
			<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
		{% endfor %}

		<h1 class="text-[#308AFF] text-[4rem]">Vitam-In</h1>
		<h2 class="text-black text-[2rem]">Se connecter</h2>

				{% if app.user %}
                        <div class="mb-3">
                            You are logged in as
                            {{ app.user.userIdentifier }},
                            <a href="{{ logout_path() }}">Logout</a>
                        </div>
                    {% endif %}

		<div class="container-form p-6 border rounded-[0.5rem] border-[#D9D9D9] shadow-md">
			<form method="post">
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

                    <div class="flex flex-col mb-6">
					    <label for="username">Email</label>
					    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control border rounded-[0.5rem] p-1" autocomplete="email" required autofocus>
				    </div>
                    <div class="flex flex-col mb-6">
                        <label for="password">Mot de passe</label>
                        <input type="password" name="_password" id="password" class="form-control border rounded-[0.5rem] p-1" autocomplete="current-password" required>
                    </div>
				    {# <div class="flex flex-col mb-6">
                        {{ form_label(registrationForm.plainPassword.second)}}
                        {{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'border rounded-[0.5rem] p-1'}})}}
                        {{ form_errors(registrationForm.plainPassword.second)}}
					</div> #}
				    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">


				    <button class="btn bg-[#2C2C2C] text-white border rounded-[0.5rem] w-full" type="submit">
					    Se connecter
				    </button>
			</form>


		</div>
	</section>

{% endblock %}
