{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
	<section class="flex flex-col items-center justify-center min-h-screen w-full gap-10 ">
		{% for flash_error in app.flashes('verify_email_error') %}
			<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
		{% endfor %}

		<h1 class="text-[#308AFF] text-[4rem]">Vitam-In</h1>
		<h2 class="text-black text-[2rem]">Mot de passe oublié</h2>


		<div class="container-form p-6 border rounded-[0.5rem] border-[#D9D9D9] shadow-md">
			<form method="post">
				{% if error %}
					<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
				{% endif %}

                    <div class="flex flex-col mb-6">
					    <label for="username">Email</label>
					    <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control border rounded-[0.5rem] p-1" autocomplete="email" required autofocus>
				    </div>
                  
				    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">


				    <button class="btn bg-[#2C2C2C] text-white border rounded-[0.5rem] w-full p-2" type="submit">
					    Envoyer
				    </button>
					
					<div class="flex flex-col mt-6">
						<a href="{{ path('app_register') }}" class="text-[#308AFF] text-center">Pas encore de compte ? Inscrivez-vous</a>
					</div>
					
			</form>


		</div>
	</section>

{% endblock %}
