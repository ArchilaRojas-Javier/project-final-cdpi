{% block body %}
	<div
		class="flex flex-col items-strech gap-2 container p-6">

			<h3 class="text-center">
				Trouvez le supplement ou le bien-être qui correpond à vos besoins.
			</h3>

			<div
				class="w-full p-2">
				
				{{ form_start(form, {'attr': {'action': path('app_search_bar')}}) }}
				{{ form_widget(form.query, {'attr': {'class': 'w-full p-1 border rounded-[1rem] p-1'}}) }}
				{{ form_end(form) }}
			</div>

		

	</div>
{% endblock %}
