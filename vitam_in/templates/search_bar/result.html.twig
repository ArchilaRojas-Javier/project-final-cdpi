{% extends 'base.html.twig' %}

{% block title %}
	Résultats de recherche - Vitam-In
{% endblock %}

{% block body %}
	<section class="flex flex-col items-center p-6 min-h-screen w-screen gap-6 mb-12">

		<h1 class="text-[#308AFF] text-[4rem]">Vitam-In</h1>

		<h2 class="text-black text-[2rem] text-center">La guide ultime des suppléments</h2>

		{{ render(controller('App\\Controller\\SearchBarController::index')) }}

		<div class="flex flex-col items-strech gap-2 p-6">

			<turbo-frame id="supplement-detail">
				{% if results is not empty %}
					<h2 class="text-2xl font-semibold text-gray-800 mt-8">
						{{ results|length }}
						résultat(s) trouvé(s)
					</h2>

					{# Conteneur avec scroll sur mobile  #}
					<div class="max-h-96 overflow-y-auto sm:max-h-full sm:overflow-y-visible">
						<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
							{% for supplement in results %}
								<a href="{{ path('app_supplement_show', {'id': supplement.id}) }}" 
										data-turbo-action="advance" 
										class="block bg-[#F0F8FD] rounded-2xl shadow hover:shadow-lg transition-shadow overflow-hidden">
									<div class="p-4">
										<h3 class="text-lg font-bold text-gray-900 mb-1">{{ supplement.name }}</h3>
										{% if supplement.description is defined %}
											<p class="text-sm text-gray-600 mt-1 line-clamp-2">{{ supplement.description }}</p>
										{% endif %}
										{% if supplement.supplementtype is defined %}
											<span class="inline-block bg-gray-200 text-gray-700 text-xs px-2 py-1 rounded-full mt-2">
												{{ supplement.supplementtype.name }}
											</span>
										{% endif %}
										<p class="text-gray-600 text-right font-bold">En savoir plus</p>
									</div>
								</a>
							{% endfor %}
						</div>
					</div>

				{% elseif form.vars.submitted %}
					<div class="text-center bg-yellow-50 border border-yellow-200 text-yellow-800 rounded-xl p-4 mt-8 w-full max-w-md">
						Aucun supplément trouvé pour cette recherche. Essayez un autre terme.
					</div>
				{% endif %}
			</turbo-frame>
		</div>
	</section>
{% endblock %}
