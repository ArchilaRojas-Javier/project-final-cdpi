{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}

	<section class="flex flex-col items-center justify-center min-h-screen w-full gap-10 ">
		{% for flash_error in app.flashes('verify_email_error') %}
			<div class="alert alert-danger" role="alert">{{ flash_error }}</div>
		{% endfor %}
		
			<h1 class="text-[#308AFF] text-[4rem]">Vitam-In</h1>
			<h2 class="text-black text-[2rem]">S'inscrire</h2>
		

		<div class="container-form p-6 border rounded-[0.5rem] border-[#D9D9D9] shadow-md">


			{{ form_errors(registrationForm) }}
			{{ form_start(registrationForm) }}

			<div class="flex flex-col mb-6">

				{{ form_label(registrationForm.email)}}
				{{ form_widget(registrationForm.email, {'attr': {'class': 'border rounded-[0.5rem] p-1'}})}}
				{{ form_errors(registrationForm.email)}}
			</div>
			<div class="flex flex-col mb-6">
				{{ form_label(registrationForm.plainPassword.first)}}
				{{ form_widget(registrationForm.plainPassword.first, {'attr': {'class': 'border rounded-[0.5rem] p-1'}})}}
				{{ form_errors(registrationForm.plainPassword.first)}}
			</div>
			<div class="flex flex-col mb-6">
				{{ form_label(registrationForm.plainPassword.second)}}
				{{ form_widget(registrationForm.plainPassword.second, {'attr': {'class': 'border rounded-[0.5rem] p-1'}})}}
				{{ form_errors(registrationForm.plainPassword.second)}}
			</div>

			
			<button type="submit" class="btn bg-[#2C2C2C] text-white border rounded-[0.5rem] w-full">S'inscrire</button>
			{{ form_end(registrationForm) }}
		</div>
	</section>
{% endblock %}
