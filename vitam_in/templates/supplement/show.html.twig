{% extends 'base.html.twig' %}

{% block title %}
	{{ supplement.name }}
	- Vitam-in
{% endblock %}


{% block body %}
	<div class="container mx-auto p-6 mb-12 ">
		<turbo-frame id="supplement-detail">

			<button type="button" onclick="if (history.length > 1) { history.back(); } else { window.location.href = '{{ path('app_home') }}'; }" 
					data-turbo="false" 
					class="inline-flex items-center text-[#308AFF] hover:underline mb-6">
				← Retour
			</button>
			<article class="bg-white rounded-2xl shadow-lg overflow-hidden max-w-3xl mx-auto">
				{% if supplement.image is defined and supplement.image %}
					<img src="{{ asset(supplement.image) }}" alt="{{ supplement.name }}" class="w-full h-64 object-cover">
				{% else %}
					<img src="https://picsum.photos/800/400?random={{ supplement.id }}" alt="{{ supplement.name }}" class="w-full h-64 object-cover">
				{% endif %}

				<div class="p-6 md:p-8">
					<h1 class="text-3xl font-bold text-gray-900 mb-3">{{ supplement.name }}</h1>

					<div class="prose max-w-none text-gray-700 mb-6">
						{% if supplement.description is defined and supplement.description %}
							<p>{{ supplement.description }}</p>
						{% else %}
							<p class="italic text-gray-500">Aucune description disponible.</p>
						{% endif %}
					</div>

					{% if supplement.dosageSchedule is defined and supplement.dosageSchedule is not empty %}
						<section class="mb-6" aria-labelledby="posologies-title">
							<h2 id="posologies-title" class="text-xl font-semibold mb-4">Posologies</h2>

							<dl class="space-y-4">
								{% if supplement.dosageSchedule.male is defined and not null %}
									<div>
										<dt class="text-lg font-medium text-gray-800">Homme</dt>
										<dd class="text-gray-700">
											{{ supplement.dosageSchedule.male.dose }}
											{{ supplement.dosageSchedule.male.unit }}
											<ul class="list-disc list-inside text-gray-600">
												{% for moment, quantity in supplement.dosageSchedule.male.moments %}
													<li>{{ moment }}
														:
														{{ quantity }}
														prise(s)</li>
												{% endfor %}
											</ul>
										</dd>
									</div>
								{% endif %}
								<dl class="space-y-4">
									{% if supplement.dosageSchedule.female is defined and not null %}
										<div>
											<dt class="text-lg font-medium text-gray-800">Femme</dt>
											<dd class="text-gray-700">
												{{ supplement.dosageSchedule.female.dose }}
												{{ supplement.dosageSchedule.female.unit }}
												<ul class="list-disc list-inside text-gray-600">
													{% for moment, quantity in supplement.dosageSchedule.female.moments %}
														<li>{{ moment }}
															:
															{{ quantity }}
															prise(s)</li>
													{% endfor %}
												</ul>
											</dd>
										</div>
									{% endif %}
								</section>
							{% endif %}

							<div class="flex items-center justify-center mb-6">
								{% if app.user %}
									{% set target_url = path('app_user_supplement_new', {supplementId: supplement.id}) %}
								{% else %}
									{% set target_url = path('app_login') %}
								{% endif %}
								<a href="{{ target_url }}" data-turbo="false" class="btn bg-[#2C2C2C] text-white border rounded-[0.5rem] w-[300px] p-2 text-center">Demarrer mon suivi</a>
							</div>

							<h2 class="text-xl font-semibold mb-2">Dureé de la cure
							</h2>

							<div>
								{% if supplement.onDurationDays is not null %}
									<p class="text-base text-gray-700 mb-2">{{ supplement.onDurationDays }}
										jours de prise recommandée</p>

								{% endif %}
							</div>

							<div>
								{% if supplement.offDurationDays is not null %}
									<p class="text-base text-gray-700 mb-2">{{ supplement.offDurationDays }}
										jours de pause recommandée</p>
								{% endif %}
							</div>


							{% if supplement.precautions is defined and not null %}
								<div class="mt-6 mb-6 ">
									<h2 class="text-xl font-semibold mb-2">Précautions</h2>
									<p class="text-gray-700">{{ supplement.precautions }}</p>
								</div>
							{% endif %}

							{# Commentaires #}
							{% if supplement.comment is defined and not null %}
								<div class="mt-6 mb-6 text-[#6E6F6F]">
									<h2 class="text-xl text-center font-semibold mb-2">Commentaires</h2>
									{# Conteneur avec scroll sur mobile #}
									<div class="w-full max-w-4xl flex-1 min-h-0 overflow-y-auto max-h-[40vh] md:max-h-none">
										<div class="flex flex-col gap-4">

											{% for comment in supplement.comment %}
												{# Nous ne montrons que ceux qui sont approuvés. #}
												{% if comment.isApprouved %}
													<div class="bg-[#F0F8FD] shadow-lg rounded-lg p-4 border border-gray-200 hover:shadow-xl transition-shadow break-words">
															
														<div class="flex items-center gap-2 mb-2">
															<div>

																{% if comment.user.avatarUrl %}
																	<img src="{{ comment.user.avatarUrl }}" alt="Avatar" class="w-10 h-10 rounded-full object-cover">
																{% else %}
																	<div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-semibold text-base">
																		{{ comment.user.email|first|upper }}
																	</div>
																{% endif %}

															</div>
															<div class="flex flex-wrap items-baseline gap-1 text-sm">
																<span class="font-medium text-gray-800">
																	{# agregar name cuando la entida user tenga name #}
																	{{ comment.user ? comment.user.email : 'Anónimo' }}
																</span>
																<span>•</span>
																<span class="text-gray-400 text-xs">{{ comment.createdAt ? comment.createdAt|date('d/m/Y H:i') : '' }}</span>
															</div>
															{# Options réservé aux utilisateurs connectés et créateur du commentaire #}
															{% if app.user and comment.user == app.user %}
																<div class="relative md:ml-auto">
																	<details class="relative inline-block">
																		<summary class="list-none cursor-pointer p-1 hover:bg-gray-100 rounded focus:outline-none">
																			{{ ux_icon('lucide:more-horizontal', { 'aria-hidden': 'true', class: 'w-5 h-5' }) }}
																		</summary>
																		<div class="absolute right-0 mt-1 w-36 bg-white border border-gray-200 rounded-md shadow-lg z-10">
																			{# <a href="{{ path('app_comment_edit', { id: comment.id }) }}" class="block w-full text-left px-4 py-2 text-sm hover:bg-gray-100">
																				✏️ Modifier
																			</a> #}
																			<form method="post" action="{{ path('app_comment_delete', { id: comment.id }) }}" style="display: inline-block; width: 100%;">
																				<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
																				<button type="submit" class="block w-full text-left px-4 py-2 text-sm hover:bg-gray-100 text-red-600">
																					🗑️ Supprimer
																				</button>
																			</form>
																		</div>
																	</details>
																</div>
															{% endif %}
														</div>
														<p class="text-gray-800 text-base leading-relaxed break-words">{{ comment.content }}</p>
														<div class="flex gap-4 mt-2 pl-4">
															
															<a href="{{ path('app_comment_show', { id: comment.id }) }}" 
																data-turbo="false"
																class="flex items-center justify-center gap-1">
																{{ ux_icon('lucide:message-square-more',{ 'aria-hidden': 'true', class: 'w-5 h-5 cursor-pointer hover:text-gray-700 rounded focus:outline-none' }) }} 
																574
															</a>
															<a href="#" 
																class="flex items-center justify-center gap-1"
																data-turbo="flase"			>
																{{ ux_icon('lucide:heart',{ 'aria-hidden': 'true', class: 'w-5 h-5 hover:text-red-700 transition-colors' }) }}
																 574
															</a>

															
														</div>
													</div>
															
												{% endif %}
												{% else %}
													<p class="text-gray-500">Aucun commentaire n'a encore été publié pour ce supplément..</p>
											{% endfor %}
										</div>
									</div>
								</div>
							{% endif %}
							{# Bouton pour ajouter un commentaire (uniquement si l'utilisateur est connecté) #}
							{% if app.user %}
								<div class="flex items-center justify-center">
									<a href="{{ path('app_comment_new', { supplementId: supplement.id }) }}" data-turbo-action="advance" class="inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700 transition">
										Partager mon expérience
									</a>
								</div>

							{% else %}
								<div class="flex items-center justify-center">
									{% if not app.user %}
										<a href="{{ path('app_register') }}" data-turbo="false" class="btn bg-[#2C2C2C] text-white border rounded-[0.5rem] w-[300px] p-2 text-center">
											Je m'inscris gratuitement
										</a>
									{% endif %}
								</div>
							{% endif %}


						</div>
					</article>
				</turbo-frame>
			</div>
		{% endblock %}
