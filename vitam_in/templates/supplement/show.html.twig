{% extends 'base.html.twig' %}

{% block title %}{{ supplement.name }}{% endblock %}

{% block body %}
<div class="container mx-auto p-6">
    <a href="{{ path('app_home') }}" class="inline-flex items-center text-[#308AFF] hover:underline mb-6">
        ← Retour aux résultats
    </a>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden max-w-3xl mx-auto">
        {% if supplement.image is defined and supplement.image %}
            <img src="{{ asset(supplement.image) }}" alt="{{ supplement.name }}" class="w-full h-64 object-cover">
        {% else %}
            <img src="https://picsum.photos/800/400?random={{ supplement.id }}" alt="{{ supplement.name }}" class="w-full h-64 object-cover">
        {% endif %}

        <div class="p-6 md:p-8">
            <h1 class="text-3xl font-bold text-gray-900 mb-3">{{ supplement.name }}</h1>


            <div class="prose max-w-none text-gray-700">
                {% if supplement.description is defined and supplement.description %}
                    <p>{{ supplement.description }}</p>
                {% else %}
                    <p class="italic text-gray-500">Aucune description disponible.</p>
                {% endif %}
            </div>
            {% if supplement.on_duration_days is defined %}
                <p class="text-2xl text-[#308AFF] font-semibold mb-4">{{ supplement.on_duration_days|number_format(2) }} jours</p>
            {% endif %}
            {% if supplement.off_duration_days is defined %}
                <p class="text-2xl text-[#308AFF] font-semibold mb-4">{{ supplement.off_duration_days|number_format(2) }} jours</p>
            {% endif %}

            {% if supplement.precautions is defined %}
                <div class="mt-6">
                    <h2 class="text-xl font-semibold mb-2">Utilisation conseillée</h2>
                    <p>{{ supplement.precautions }}</p>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}