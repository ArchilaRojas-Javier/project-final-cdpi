{% extends 'base.html.twig' %}

{% block title %}UserSupplement index{% endblock %}

{% block body %}
    <h1>UserSupplement index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Dosage_schedule</th>
                <th>Start_date</th>
                <th>Duration_days</th>
                <th>Precautions</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user_supplement in user_supplements %}
            <tr>
                <td>{{ user_supplement.id }}</td>
                <td>{{ user_supplement.dosageSchedule ? user_supplement.dosageSchedule|json_encode : '' }}</td>
                <td>{{ user_supplement.startDate ? user_supplement.startDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ user_supplement.durationDays }}</td>
                <td>{{ user_supplement.precautions }}</td>
                <td>
                    <a href="{{ path('app_user_supplement_show', {'id': user_supplement.id}) }}">show</a>
                    <a href="{{ path('app_user_supplement_edit', {'id': user_supplement.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_user_supplement_new') }}">Create new</a>
{% endblock %}
