{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
    <section class="flex flex-col items-center justify-center min-h-screen w-full gap-10 ">

        {% for flash_error in app.flashes('reset_password_error') %}
            <div class="alert alert-danger" role="alert">{{ flash_error }}</div>
        {% endfor %}
    
        <h1 class="text-[#308AFF] text-[4rem]">Vitam-In</h1>
		<h2 class="text-black text-[2rem]">Mot de passe oublié</h2>

        <div class="container-form p-6 border rounded-[0.5rem] border-[#D9D9D9] shadow-md">
            {{ form_start(requestForm) }}
            
            <div class="flex flex-col mb-6">
                {{ form_label(requestForm.email)}}
				{{ form_widget(requestForm.email, {'attr': {'class': 'border rounded-[0.5rem] p-1'}})}}
				{{ form_errors(requestForm.email)}}
			</div>
            
            <button class="btn btn-primary bg-[#2C2C2C] text-white border rounded-[0.5rem] w-full p-2">Envoyer</button>
            {{ form_end(requestForm) }}
        </div>
    </section>
{% endblock %}
