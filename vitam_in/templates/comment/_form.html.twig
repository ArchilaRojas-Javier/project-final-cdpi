{{ form_start(form, { attr: { 'data-turbo-frame': 'supplement-detail' } }) }}
{{ form_widget(form) }}
<div class="flex gap-4 mt-4">
	<button type="submit" class="btn bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
		Publier
	</button>

	<button type="button" 
            onclick= "if (history.length < 1) { history.back(); } else { window.location.href = '{{ path('app_home') }}'; } "
            data-turbo="false" 
            class="btn bg-gray-300 text-gray-700 px-6 py-2 rounded hover:bg-gray-400">
		Annuler
	</button>
</div>
{{ form_end(form) }}
