<div
	class="bg-white shadow">
	{# data-controller attribue ce contrôleur à l'élément et à tout son contenu #}
	<div data-controller="mobile-menu" class="container mx-auto flex items-center justify-between p-4 relative">

		{% if this.showTitle %}
			<h1 class="text-5xl font-bold text-[#308aff]">
				<a href="{{ path('app_home') }}" aria-label="Accueil - Vitam-in">
					Vitam-in
				</a>
			</h1>
		{% endif %}
		{# Bouton burger: 
					- data-action : Au clic, exécuter la méthode « toggle » du contrôleur « mobile-menu ».
					- md:hidden : Masquer sur ordinateur.
				#}
		<button data-action="click->mobile-menu#toggle" class="md:hidden p-2 rounded focus:outline-none focus:ring-2 focus:ring-gray-300" aria-label="Ouvrir le menu de navigation">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
			</svg>
		</button>
		{# Menu de navigation:
		        	-L'attribut `data-mobile-menu-target="menu"` associe l'élément à la cible `menu` du contrôleur.
				#}
		<nav data-mobile-menu-target="menu" class="hidden md:flex md:items-center md:space-x-6 absolute md:static top-full left-0 w-full md:w-auto
						 bg-white md:bg-transparent shadow md:shadow-none" aria-label="Menu principal" role="navigation">
			<ul class="flex flex-col md:flex-row p-4 md:p-0 space-y-2 md:space-y-0 md:space-x-6">
				{% for item in this.menuItems %}
					<li>
						<a href="{{ path(item.route) }}" data-action="click->mobile-menu#close" class="text-gray-700 hover:text-gray-900 block py-2">
							{{ item.label }}
						</a>
					</li>
				{% endfor %}
			</ul>
		</nav>
	</div>
</div>

