<header
	class="bg-white shadow">
	{# data-controller asigna este controlador al elemento y a todo su interior #}
	<div data-controller="mobile-menu" class="container mx-auto flex items-center justify-between p-4 relative">

		{% if this.showTitle %}
			<a href="{{ path('app_home') }}" class="text-xl font-bold text-gray-800">
				Vitam-in
			</a>
		{% endif %}

		{# Botón hamburguesa: 
            - data-action: al hacer click, ejecuta el método 'toggle' del controlador 'mobile-menu'
            - md:hidden para que se oculte en escritorio
        #}
		<button data-action="click->mobile-menu#toggle" class="md:hidden p-2 rounded focus:outline-none focus:ring-2 focus:ring-gray-300">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewbox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
			</svg>
		</button>

		{# Menú de navegación:
            - data-mobile-menu-target="menu" lo conecta con el target 'menu' del controlador
            - clases hidden y md:flex funcionan igual que antes
        #}
		<nav data-mobile-menu-target="menu" 
            class="hidden md:flex md:items-center md:space-x-6 absolute md:static top-full left-0 w-full md:w-auto bg-white md:bg-transparent shadow md:shadow-none">
			<ul class="flex flex-col md:flex-row p-4 md:p-0 space-y-2 md:space-y-0 md:space-x-6">
				{% for item in this.menuItems %}
					<li>
						<a href="{{ path(item.route) }}" data-action="click->mobile-menu#close" class="text-gray-700 hover:text-gray-900 block py-2">
							{{ item.label }}
						</a>
					</li>
				{% endfor %}
			</ul>
		</nav>
	</div>
</header>
