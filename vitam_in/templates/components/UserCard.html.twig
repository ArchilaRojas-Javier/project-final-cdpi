{% if this.userName %}
	<div
		class="container mx-auto">

        <div class="flex items-center justify-between bg-[#fffff] m-6 p-4">
                {# Lado izquierdo: nombre #}
                <div class="text-base text-[#6E6F6F]">
                    <p class="text-2xl">Bonjour,</p>
                    <span>{{ this.userName }}</span>
                </div>

                {#Lado derecho: avatar#}
                <div>

                    {% if this.avatarUrl %}
                        <img src="{{ this.avatarUrl }}" alt="Avatar" class="w-10 h-10 rounded-full object-cover">
                    {% else %}
                        <div class="w-10 h-10 rounded-full bg-blue-600 text-white flex items-center justify-center font-semibold text-base">
                            {{ this.userName|first|upper }}
                        </div>
                    {% endif %}

                </div>
            </div>
    </div>
{% endif %}
