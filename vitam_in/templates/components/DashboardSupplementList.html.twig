<div {{ attributes }}>
    <table class="table table-bordered mx-auto">
        <thead>
            <tr>
                <th scope="col" class="text-center">
                    <span class="sr-only">Supplément</span>
                    {{ ux_icon('lucide:pill',{ 'aria-hidden': 'true' }) }}
                </th>
                <th scope="col" class="text-center">
                    <span class="sr-only">Jours restants</span>
                    {{ ux_icon('lucide:calendar-1',{ 'aria-hidden': 'true' }) }}
                </th>
                <th scope="col" class="text-center">
                    <span class="sr-only">Dosage</span>
                    {{ ux_icon('lucide:scale',{ 'aria-hidden': 'true' }) }}
                </th>
                <th scope="col" class="text-center">
                    <span class="sr-only">Notes</span>
                    {{ ux_icon('lucide:notebook-pen',{ 'aria-hidden': 'true' }) }}
                </th>
                <th scope="col" class="text-center">
                    <span class="sr-only">Options</span>
                    {{ ux_icon('lucide:more-horizontal',{ 'aria-hidden': 'true' }) }}
                </th>
            </tr>
        </thead>
        <tbody>
            {% for userSupplement in this.userSupplements %}
                <tr>
                    {% if this.editingId == userSupplement.id %}
                        {# Modo edición: mostramos el formulario ocupando toda la fila #}
                        <td colspan="5">
                            {{ form_start(this.form, {
                                action: '#',
                                attr: { 'data-live-action': 'saveEdit' }
                            }) }}
                                {{ form_errors(this.form) }}
                                
                                {# Mostramos el nombre de solo lectura (usando los datos planos) #}
                                <div class="mb-2">
                                    <strong>Suplemento:</strong> {{ userSupplement.supplementName }}
                                </div>
                                
                                {{ form_row(this.form.dosis) }}
                                {{ form_row(this.form.startDate) }}
                                {{ form_row(this.form.endDate) }}
                                
                                <div class="mt-2">
                                    <button type="submit" class="btn btn-primary btn-sm">Guardar</button>
                                    <button type="button" class="btn btn-secondary btn-sm" data-live-action="cancelEdit">Cancelar</button>
                                </div>
                            {{ form_end(this.form) }}
                        </td>
                    {% else %}
                        {# Vista normal: usamos los datos planos #}
                        <td>{{ userSupplement.supplementName }}</td>
                        <td>{{ userSupplement.daysRemaining }}</td>
                        <td>{{ userSupplement.dosageSummary }}</td>
                        <td>{{ userSupplement.notesCount }}</td>
                        <td>
                            <button class="btn btn-warning btn-sm"
                                    data-live-action="startEdit"
                                    data-live-id="{{ userSupplement.id }}">
                                ✏️ Editar
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    data-live-action="delete"
                                    data-live-id="{{ userSupplement.id }}"
                                    onclick="return confirm('¿Eliminar este suplemento?')">
                                🗑️ Borrar
                            </button>
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr><td colspan="5">Ajoutez votre premier supplément pour suivre vos progrès.</td></tr>
            {% endfor %}
        </tbody>
    </table>
</div>